# Google OAuth Client IDs — https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Google AI (Gemini) API key — https://aistudio.google.com/apikey
EXPO_PUBLIC_GOOGLE_AI_API_KEY=AIza...

# Anthropic Claude — used by api/ai/stock-analyze-deep (deep stock analysis).
# Without this key the "ניתוח מתקדם" mode returns 503 and falls back to a
# generic shark-voice error. Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Perplexity Search API — grounds the deep stock analyzer in fresh web data
# (insider activity, upcoming catalysts, analyst targets, current sentiment)
# that Opus's January-2026 training cutoff can't see. Without this key the
# deep analyzer still runs but factual fields fall back to "unknown" instead
# of being hallucinated. Get key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-key-here

# Neon PostgreSQL — https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API base URL (Vercel deployment)
EXPO_PUBLIC_API_URL=https://your-vercel-domain.vercel.app/api

# Alpha Vantage market data — https://www.alphavantage.co/support/#api-key
EXPO_PUBLIC_ALPHA_VANTAGE_API_KEY=your-api-key

# Resend email — https://resend.com
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=FinPlay <noreply@yourdomain.com>
CRON_SECRET=your-random-secret-here

# 32+ char random string — signs email click-tracking URLs (HMAC).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_TRACKING_SECRET=your-random-secret-here

# RevenueCat — https://app.revenuecat.com
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_your_google_key_here
EXPO_PUBLIC_RC_APPLE_KEY=appl_your_apple_key_here
EXPO_PUBLIC_RC_WEBHOOK_SECRET=your-webhook-secret-here
# Server-side secret the RevenueCat webhook (api/webhooks/revenuecat.ts) checks
# against RC's Authorization header. Set this in Vercel env — the EXPO_PUBLIC_
# one above is a client-build var and is accepted only as back-compat fallback.
RC_WEBHOOK_SECRET=your-webhook-secret-here

# Sentry error tracking — https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# PostHog product analytics — https://posthog.com
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-side capture key (same phc_ project write key). REQUIRED in Vercel for
# server events (RevenueCat webhook, email funnel) — the EXPO_PUBLIC_ key above
# is a client-build var absent in the function runtime, so without this every
# server-side capture silently drops. See api/_shared/posthogCapture.ts.
POSTHOG_API_KEY=phc_your_project_api_key
POSTHOG_HOST=https://eu.i.posthog.com
# Personal API key for server-side queries (funnel/trends/SQL). DO NOT prefix
# with EXPO_PUBLIC — gives full account read access.
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key
POSTHOG_PROJECT_ID=000000

# ElevenLabs — TTS + Conversational AI (live Captain Shark voice call).
# API key:  https://elevenlabs.io/app/settings/api-keys
# AGENT_ID: the Conversational AI agent (Liam v3 + Gemini) — read by
#   api/voice/session.ts + api/voice/token.ts to mint signed URLs / LiveKit
#   tokens. Enable prompt/firstMessage/language overrides + dynamic variables
#   in the agent's security settings (per-module comprehension questions).
# VOICE_ID: Liam's voice id (configured on the agent; kept here for reference).
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=agent_your-conversational-agent-id
ELEVENLABS_VOICE_ID=your-chosen-voice-id

# Ad-performance reporting (server-only) — powers Bar's automated ad analysis.
# api/ads/meta.ts pulls Meta (FB/IG) Ads performance via the Marketing API so a
# cloud routine can read it on a schedule. Set these in Vercel env (NOT a client
# build var — never prefix with EXPO_PUBLIC).
# META_ADS_TOKEN: a Meta System User token with `ads_read` on the ad account
#   (Business Settings → System Users → Generate token). Keep it server-side.
# META_AD_ACCOUNT_ID: the ad account, e.g. act_1234567890 (the act_ prefix is
#   added automatically if omitted).
# META_GRAPH_VERSION: optional override if Meta sunsets the default Graph version.
META_ADS_TOKEN=your-meta-system-user-token
META_AD_ACCOUNT_ID=act_1234567890
META_GRAPH_VERSION=v21.0
# Shared secret the /api/ads/* endpoints require in the Authorization header
# (Bearer or raw). The Bar cloud routine sends it when fetching the report.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADS_REPORT_SECRET=your-random-secret-here

# Google Ads reader (api/ads/google.ts). Google Ads has no single long-lived
# token — a refresh token is exchanged for an access token per call. All five
# are REQUIRED; set in Vercel env (server-only, never EXPO_PUBLIC).
# - DEVELOPER_TOKEN: Google Ads API Center → API access (needs Google approval).
# - CLIENT_ID / CLIENT_SECRET: an OAuth 2.0 Desktop/Web client (Google Cloud).
# - REFRESH_TOKEN: from the OAuth consent flow with scope adwords (read).
# - CUSTOMER_ID: the ad account, DIGITS ONLY, no dashes (e.g. 1234567890).
# - LOGIN_CUSTOMER_ID: optional MCC/manager id (digits only) if access is via a
#   manager account. API_VERSION: optional override (default v17).
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-oauth-refresh-token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v17
