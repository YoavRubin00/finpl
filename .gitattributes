# Force LF for EAS ignore file
.easignore text eol=lf

# Exclude heavy assets from EAS Build archive (git archive)
assets/video/ export-ignore
assets/videos/ export-ignore
assets/comics/ export-ignore
assets/infographics/ export-ignore
assets/SOUND/ export-ignore
notebooklm-py/ export-ignore
skills/ export-ignore
docs/ export-ignore
scripts/ export-ignore
generated/ export-ignore
# Anchored to the repo root on purpose (Yoav 11.10.26): the unanchored `db/`
# also matched `src/db/`, which holds `apiBase.ts` — imported by ~50 client
# files — so every `git archive` (and the cloud `eas update`) shipped a tree
# that could not resolve `src/db/apiBase`.
/db/ export-ignore
/public/ export-ignore
