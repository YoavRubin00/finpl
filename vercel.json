{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "src/features/email/welcomeEmail.html"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/email/send-daily",
      "schedule": "0 6 * * *"
    }
  ],
  "git": {
    "submodules": false
  }
}
